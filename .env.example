# Copy to `.env` and adjust. See GOOGLE_OAUTH_SETUP.md for SSO.

# Set to `true` to skip Google sign-in and use a local demo player (no DB saves).
VITE_DISABLE_GOOGLE_AUTH=false

# Google OAuth (required when SSO enabled)
# VITE_GOOGLE_CLIENT_ID=

# --- PostgreSQL API (server/index.ts) ---
# Required for `npm run dev:all`. Same DATABASE_URL on office + home if both hit one Postgres.
# Examples:
#   postgresql://tower_app:secret@192.168.1.50:5432/tower_defense
#   postgresql://user:pass@db.example.com:5432/tower_defense?sslmode=require
DATABASE_URL=

# API binds to all interfaces so LAN / VPN / Tailscale clients can reach it (TLS usually via reverse proxy).
API_HOST=0.0.0.0
API_PORT=3001

# Managed Postgres / TLS: set DATABASE_SSL=true or PGSSLMODE=require
# DATABASE_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=true

# Comma-separated browser origins for CORS, or * for any origin (dev only).
# Add your office hostname, home lab URL, and LAN IPs as needed.
CORS_ORIGIN=*

# Frontend: base URL for REST calls. Leave unset to use same-origin `/api` (Vite proxies to API_PORT).
# Use when the UI is served from one machine and the API from another (e.g. phone hits Vite on PC A, API on PC B).
# VITE_API_BASE_URL=http://192.168.1.50:3001

# --- Home access note ---
# If you develop from home, expose API_PORT through VPN/Tailscale and include your home URL in CORS_ORIGIN.
# Example:
# CORS_ORIGIN=http://tower.cpss.edu.hk,http://100.117.199.40:5173
