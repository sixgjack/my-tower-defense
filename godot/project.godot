; Engine configuration file.
; Godot 4.x — Neon Defense (Godot port)

config_version=5

[application]

config/name="Neon Defense"
config/description="Godot 4 student client — coexists with the React/web Neon Defense; phones, tablets, desktop."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConstants="*res://scripts/autoload/game_constants.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=5
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
